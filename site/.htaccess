# Página de erro personalizada
ErrorDocument 404 /404.html

# Acentos corretos e tipos de arquivo usados pelo site
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/vcard .vcf
</IfModule>

# Sempre buscar a versão mais recente das páginas (evita o celular mostrar uma cópia antiga)
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Cabeçalhos de segurança (LGPD, art. 46: medidas técnicas de proteção)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Endereços sem ".html" também funcionam (ex.: /treinamento, /privacidade, /termos)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>
